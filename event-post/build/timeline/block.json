{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "eventpost/timeline",
  "version": "6.0.0",
  "title": "Events Timeline",
  "icon": "arrow-right-alt",
  "category": "common",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false
  },
  "attributes": {
    "nb": {
      "type": "number",
      "default": 0
    },
    "future": {
      "type": "boolean"
    },
    "past": {
      "type": "boolean"
    },
    "cat": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "geo": {
      "type": "boolean"
    },
    "blogs": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "before_title": {
      "type": "string"
    },
    "after_title": {
      "type": "string"
    },
    "excerpt": {
      "type": "boolean"
    },
    "order": {
      "type": "string",
      "default": "ASC"
    },
    "separate_years": {
      "type": "boolean",
      "default": false
    },
    "separate_months": {
      "type": "boolean",
      "default": false
    },
    "direction": {
      "type": "string",
      "default": "horizontal"
    },
    "style": {
      "type": "string"
    },
    "size": {
      "type": "number",
      "default": 2
    },
    "color": {
      "type": "string",
      "default": "#000000"
    }
  },
  "textdomain": "eventpost",
  "script": "file:./event-timeline.js",
  "style": "file:./event-timeline.css",
  "editorScript": "file:./index.js"
}